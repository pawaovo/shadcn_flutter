 static void fl_accessible_node_set_name_impl(FlAccessibleNode* self,
                                              const gchar* name) {
   FlAccessibleNodePrivate* priv = FL_ACCESSIBLE_NODE_GET_PRIVATE(self);
+  // Track assignment independently: clearing the name must not make the next
+  // assignment look like initialization again.
+  const gboolean had_name = priv->name_initialized;
+  priv->name_initialized = TRUE;
+  if (g_strcmp0(priv->name, name) == 0) {
+    return;
+  }
+  // Like atk_object_set_name, do not notify for initial name assignment.
   g_free(priv->name);
   priv->name = g_strdup(name);
+  if (had_name) {
+    g_object_notify(G_OBJECT(self), "accessible-name");
+  }
 }
 
